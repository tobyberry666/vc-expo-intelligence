{
  "name": "vc-expo-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build --config vite.standalone.config.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint src tests e2e",
    "precommit": "npm run lint",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:platform": "npm run typecheck && vite build --outDir dist-platform",
    "preview": "vite preview --config vite.standalone.config.ts --host 127.0.0.1 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test:coverage && npm run test:tooling && npm run build && npm run format:check",
    "test:e2e": "node scripts/run-browser-tests.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "test:tooling": "node --test tests/audit-gate.test.mjs tests/dev-script.test.mjs"
  },
  "dependencies": {
